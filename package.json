{
  "name": "codex-bili-dragon",
  "version": "0.9.0",
  "private": true,
  "description": "Codex Bili Dragon — a local Bilibili companion with a daily rhythm, diaries and reviewed interactions",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node dist/runtime/cli.js start",
    "mcp": "node dist/runtime/mcp.js",
    "doctor": "node dist/runtime/cli.js doctor",
    "doctor:protocol": "node dist/runtime/cli.js doctor --protocol",
    "build": "vp run --filter \"@bili-dragon/*\" build && node scripts/update-manifest.ts",
    "check": "vp check && node scripts/check.ts",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "format": "vp fmt",
    "package": "node --experimental-strip-types scripts/package.ts",
    "package:marketplace": "node --experimental-strip-types scripts/prepare-marketplace.ts",
    "test:ui": "vp test run --config scripts/ui.vite.config.ts",
    "test:package": "vp test run --config scripts/package.vite.config.ts",
    "test:behavior": "vp test run --config scripts/behavior.vite.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@orpc/server": "1.16.1",
    "fflate": "0.8.3",
    "luxon": "3.7.2",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite-plus": "1.4.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}
